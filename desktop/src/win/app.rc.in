/*
 * Room Browser (desktop) - Windows resource script template.
 *
 * CMake configures this file to app.rc in the binary directory, substituting
 * @RB_VERSION@ (e.g. "1.0.86") and @RB_VERSION_COMMA@ (e.g. 1,0,86,0).
 * "app.manifest" and "icon.ico" are copy-configured into the same binary
 * directory, so bare relative file names are used here on purpose.
 * This file is kept pure ASCII (no (c) glyph; wide chars avoided).
 */
#include "resource.h"
#include <windows.h>

IDI_ICON1 ICON "icon.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RB_VERSION_COMMA@
 PRODUCTVERSION @RB_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Maragung"
            VALUE "FileDescription", "Room Browser - privacy desktop browser"
            VALUE "FileVersion", "@RB_VERSION@"
            VALUE "InternalName", "RoomBrowser"
            VALUE "LegalCopyright", "Copyright (c) 2026 Maragung"
            VALUE "OriginalFilename", "RoomBrowser.exe"
            VALUE "ProductName", "Room Browser"
            VALUE "ProductVersion", "@RB_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
