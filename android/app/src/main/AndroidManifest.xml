<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Geolocation. Without these the app could never truthfully grant a
         page's location request: the WebView asks the APP, the app can only
         say yes when it holds the runtime permission itself, and a site
         handed a "yes" it cannot honour gets a position error instead of a
         refusal. Coarse is requested alongside fine so the user may answer
         with approximate location on Android 12+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Legacy storage for API 28 only; API 29+ uses MediaStore -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!--
      Package visibility (API 30+). Without this the WebView-provider probe in
      ProfileEngine.installedWebViewEngines() throws NameNotFoundException for
      every candidate, so the Settings -> Engine list could only ever show the
      single active provider. Read-only diagnostics: we ask about these five
      packages by name rather than holding QUERY_ALL_PACKAGES.
    -->
    <queries>
        <package android:name="com.google.android.webview" />
        <package android:name="com.android.webview" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.android.chrome" />
    </queries>


    <application
        android:name=".RoomBrowserApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RoomBrowser"
        tools:targetApi="35">

        <!--
          allowBackup="false" is the operative setting: this app holds wallet
          keys and a password vault, so nothing leaves the device through
          backup. The two rule files below are therefore INERT today and are
          kept only as defence in depth, so that re-enabling backup can never
          silently ship the sensitive directories. usesCleartextTraffic="true"
          is required of a browser — it must be able to load http:// pages the
          user navigates to; the wallet's own RPC endpoints are separately
          restricted to https:// in WalletEngine.isValidNetworkConfig.
        -->

        <!-- Launcher + default browser candidate: profile picker / profile chooser -->
        <!--
          singleTask: this activity overrides onNewIntent to route an incoming
          VIEW/SEND intent into the live profile chooser. Under the default
          "standard" launch mode that override is dead code — every shared URL
          would stack a second MainActivity (and a second MainViewModel) on the
          task instead.
        -->
        <activity
            android:name=".main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Default-browser candidacy -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Share sheet target: receiving shared URLs/text -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The browsing engine runs in a dedicated ':browser' process.
          WebView.setDataDirectorySuffix(profileId) is process-wide, so this
          process hosts exactly ONE profile at a time. Switching profiles
          destroys the WebView tree and restarts this process — this is what
          provides real cookie/localStorage/IndexedDB/cache isolation.
        -->
        <activity
            android:name=".browser.BrowserActivity"
            android:process=":browser"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <!-- QR scanner (camera) — separate process keeps camera off the engine process -->
        <!-- configChanges mirrors the sibling activities: without it a rotation
             mid-scan recreates the activity and restarts the camera session. -->
        <activity
            android:name=".qr.QrScannerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode" />

        <!--
          AI agent settings / provider editor / chat history — their OWN
          activities (default process, no WebView). Provider management and
          the advanced agent menus get a real window: proper back-stack
          behavior, own IME handling and edge-to-edge insets, exactly like
          the QR scanner. State is shared with the ':browser' process via
          the Room database (multi-instance invalidation).
        -->
        <activity
            android:name=".agent.ui.AgentSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".agent.ui.AgentProviderEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".agent.ui.AgentSessionsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode" />

        <!--
          Local AI (Ollama) manager — its OWN activity (default process, no
          WebView), exactly like the other agent screens: connecting to an
          Ollama server, the phone-friendly model catalog with
          pause/resume downloads, GPU/CPU tuning and setup import/export get
          a real window with proper back-stack behavior, own IME handling
          and edge-to-edge insets.
        -->
        <activity
            android:name=".agent.ui.LocalAiActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Per-profile Theme Studio — its OWN activity (default process):
          live preview, 18 presets, full palette/gradient/shape editor,
          custom theme gallery, JSON import/export.
        -->
        <activity
            android:name=".theme.ui.ThemeStudioActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Profile Network Warning — a DEDICATED full-screen activity in the
          ':browser' process (it must never be shown as a dismissible dialog):
          while the pending-decision flag stands, browsing is gated and this
          window is re-launched until the user picks Continue / Switch Profile
          / Don't-warn-again. Survives rotation, process death and recreation.
        -->
        <activity
            android:name=".browser.NetworkWarningActivity"
            android:process=":browser"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Device picker — its OWN activity (default process, no WebView):
          full-screen searchable catalogue with "in use" marks; launched for
          a result from the profile settings screen in ':browser'.
        -->
        <activity
            android:name=".browser.ui.DevicePickerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Password manager — the per-profile vault UI. Runs in the ':browser'
          process ON PURPOSE: CredentialRepository's session lock is per-process
          AppGraph state, so unlocking here shares the session with the browsing
          engine (in-page login offers + save prompts); it never hosts a WebView.
        -->
        <activity
            android:name=".browser.ui.PasswordsActivity"
            android:process=":browser"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Multi-chain wallet — dashboard, onboarding, send/receive and dApp
          confirmations for the bound profile. ':browser' process like the
          password manager: WalletEngine is per-process AppGraph state, so
          unlocking here shares the session with the in-page dApp bridge;
          it never hosts a WebView.
        -->
        <activity
            android:name=".browser.ui.WalletActivity"
            android:process=":browser"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <!--
          AI agent background execution: while an agent turn runs, this
          dataSync foreground service keeps the ':browser' process alive and
          holds a partial wake lock, so tasks continue with the app in the
          background or the screen off. It also shows the agent's progress
          notification (with a Stop action).
        -->
        <service
            android:name=".agent.AgentKeepAliveService"
            android:process=":browser"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Download notification actions (Pause / Resume / Cancel / Retry / Open).
          A notification action can only be delivered as a broadcast, and these
          were being sent to nothing before this receiver existed. Not exported:
          the PendingIntents set the package explicitly, so only this app can
          reach it.

          process=":browser" is load-bearing. The receiver resolves the live
          queue through DownloadEngine.current, a per-process @Volatile that
          only BrowserViewModel — which runs in ':browser' — ever assigns. In
          the default process that field is permanently null, so every
          notification button silently did nothing: exactly the bug this
          receiver was added to fix.
        -->
        <receiver
            android:name=".browser.engine.DownloadActionReceiver"
            android:process=":browser"
            android:exported="false">
            <intent-filter>
                <action android:name="com.roombrowser.DOWNLOAD_ACTION" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager on-demand initialization (RoomBrowserApp implements
             Configuration.Provider); removes the default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
