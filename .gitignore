# Desktop (Rust) build outputs — target/ is cargo's scratch tree (multi-GB),
# rebuilt from source by CI and by `cargo build`; never track it.
desktop/target/
desktop/dist/

# CI scratch
release-out/
ci-logs/
e2e-logcat-*.txt

# Python scratch from the generators in android/tools
__pycache__/
*.pyc

# Gradle / Android scratch at repo root (real patterns live in android/.gitignore)
.gradle/
local.properties
.cxx/
.kotlin/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
*.hprof
captures/

# Secrets and signing — NEVER commit
*.jks
*.keystore
keystore.properties
secrets.properties
*.pem
*.p12
