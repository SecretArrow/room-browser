# ktlint reads this from the linted file's directory upward; root=true stops the
# walk at the repo so a stray parent config cannot change what CI enforces.
root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Long explanatory comments are deliberate here — judge structure, not prose.
max_line_length = off

# Compose files use wildcard imports by convention and by template.
ktlint_standard_no-wildcard-imports = disabled

# The agent's multi-line prompt strings read better hand-indented.
ktlint_standard_string-template-indent = disabled

# ---------------------------------------------------------------------------
# Layout rules that fight this codebase's deliberate style, turned off so the
# gate can be blocking without a 500-file rewrite. Each was measured against
# the whole tree (65,766 hits) before being disabled here — this is a decision
# about what the gate enforces, not a way to make it pass.
#
#   argument-list-wrapping (9,136)  would reflow the generated device table in
#                                   core/domain/model/Devices.kt from 7,156
#                                   lines to 16,345 — one named arg per line.
#   indent (35,733)                 continuation-indent convention differs
#                                   throughout; largely a consequence of the
#                                   wrapping rules below.
#   multiline-expression-wrapping   splits the idiomatic `fun f() = apply { }`
#   (3,741)                         onto two lines.
#   function-signature,             parameter/class/statement wrapping prefs.
#   class-signature, statement-
#   wrapping, wrapping, chain-
#   wrapping, condition-wrapping,
#   parameter-list-wrapping,
#   enum-wrapping, if-else-wrapping,
#   multiline-if-else
#   trailing-comma-on-*-site        8,074 hits, almost all inside the device
#   (8,074)                         table's multi-arg lines.
#   chain-method-continuation,      ktlint_official-only rules.
#   if-else-bracing, no-consecutive-
#   comments, no-empty-first-line-
#   in-class-body
#   function-naming (568)           flags @Composable PascalCase functions.
#   blank-line-before-declaration   the codebase opens class bodies and groups
#   (231)                           declarations with blank lines on purpose.
# ---------------------------------------------------------------------------
ktlint_standard_indent = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_chain-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_if-else-bracing = disabled
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_blank-line-before-declaration = disabled
