<?xml version="1.0" encoding="utf-8"?>
<!--
  Room Browser launcher mark — BACKGROUND layer.
  Violet gradient: this is the WebView edition's colour. The GeckoView
  edition is deliberately orange, so do not sync the two.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startColor="#4C1D95"
                android:centerColor="#7C3AED"
                android:endColor="#A78BFA"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108" />
        </aapt:attr>
    </path>
    <!-- subtle radial glow behind the glyph -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="62"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
