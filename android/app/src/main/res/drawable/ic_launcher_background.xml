<?xml version="1.0" encoding="utf-8"?>
<!--
  Room Browser 2026 launcher mark — BACKGROUND layer.
  Burnt-orange → orange → amber gradient (original identity,
  not derived from any other product's assets).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startColor="#7C2D12"
                android:centerColor="#EA580C"
                android:endColor="#F59E0B"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108" />
        </aapt:attr>
    </path>
    <!-- subtle radial glow behind the glyph -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="62"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
